NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
API_BASE_URL=http://localhost:3000
# Şifre sıfırlama e-postasındaki callback origin'i. Prod'da panelin genel
# adresini birebir yaz (örn. https://panel.example.com). Boşsa dev'de
# tarayıcı origin'i (window.location.origin) kullanılır.
NEXT_PUBLIC_SITE_URL=

# Ayrı ve düşük yetkili demo hesabıyla şifresiz ürün inceleme butonu.
# Üçü de NEXT_PUBLIC_ DEĞİL; yalnızca sunucuda kalır. Gerçek otel hesabı kullanma.
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=

# Misafir Demo sayfasının yüklediği widget script adresi. Boşsa panelin
# public/ klasöründen '/green-gold-widget.v1.js' servis edilir (dev).
# Prod'da gerçek widget URL'ini yaz (örn. https://<panel-domain>/green-gold-widget.v1.js).
NEXT_PUBLIC_WIDGET_SRC=

# Public /demo sayfasının önizlediği DEMO tenant'ının widget key'i.
# Tasarımı gereği PUBLIC (embed kodunda zaten görünür; hassas değil).
# Boşsa /demo nazikçe "kullanılamıyor" gösterir. Demo tenant'ın allowed_origins'ine
# panel prod origin'i eklenmiş OLMALI (yoksa config fetch prod'da 403 alır).
NEXT_PUBLIC_DEMO_WIDGET_KEY=
