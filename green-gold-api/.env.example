SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
PORT=3000
# Operatör create-hotel script'inin bastığı embed kodundaki data-api adresi.
# Boşsa http://localhost:3000 kullanılır; prod'da gerçek API adresini yaz.
API_PUBLIC_URL=
# Davet linkinin döneceği panel adresi (create-hotel). Boşsa http://localhost:3001.
# Supabase Redirect URLs'e <PANEL_URL>/auth/callback eklenmeli.
PANEL_URL=

# Dağıtık rate limit (Upstash Redis REST). Vercel/çok-instance deploy'da ZORUNLU —
# yoksa rate limit bellek-içi best-effort'a düşer (instance'lar arası paylaşılmaz).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 3pmetrics karbon ölçüm sağlayıcısı (src/carbon/*).
# sandbox -> https://connect-test.3pmetrics.io (IP whitelist'li), production -> https://connect.3pmetrics.io
CARBON_PROVIDER_ENVIRONMENT=sandbox
# Yalnızca test/proxy için; boşsa resmi adres kullanılır.
THREEPMETRICS_BASE_URL=
# API anahtarı asıl olarak Supabase Vault'ta durur (migration 0016, npm run link-threepmetrics -- --store-secret).
# Bu env değişkeni yalnızca --check / --store-secret girdisi ve sandbox yedeğidir; production'da API env'i OKUMAZ.
# authorization_ref = GREENGOLD -> CARBON_PROVIDER_SECRET_GREENGOLD. Repoya ASLA koyma.
CARBON_PROVIDER_SECRET_GREENGOLD=
